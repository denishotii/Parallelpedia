# DKG Configuration
# Base URL for the OriginTrail DKG Node
# Default: http://localhost:9200
DKG_BASE_URL=http://localhost:9200

# OpenAI Configuration (Optional)
# Required only if you want to use advanced LLM-based comparison features
# The app will work without this using TF-IDF similarity
# OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration (Optional)
# Port for the FastAPI server (default: 8000)
# PORT=8000
